# ---- Copy to .env and fill in. The app reads these at runtime. ----

# REQUIRED for real model output in the local/hybrid profile.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Which config profile to load: local | hybrid | aws
IGR_PROFILE=local

# Optional overrides
# IGR_LLM_MODEL=openai/gpt-4o-mini
# IGR_VISION_MODEL=openai/gpt-4o-mini
# IGR_EMBED_PROVIDER=local          # local | openrouter | bedrock
# IGR_PORT=8077
# IGR_DATA_DIR=./storage

# ---- Neo4j (only if graph_store.provider = neo4j) ----
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=neo4j

# ---- AWS (only for the aws profile) ----
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ---- Web research (optional; enables Tavily augmentation) ----
# TAVILY_API_KEY=

# ---- API auth: REQUIRED in non-local (hybrid/aws) profiles ----
# IGR_API_TOKEN=

# ---- Document preview source roots (':'-separated; legacy alias IGR_PREVIEW_ROOTS) ----
# PREVIEW_ROOTS=

# ---- Parser override: docling | advanced | textract | bedrock | bda ----
# IGR_PARSER=
